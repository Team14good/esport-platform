# 環境設定（只提交 .env.example；與 .dockerignore 一致，.env.local 這類也一律忽略）
.env
.env.*
!.env.example

# BMAD 安裝程式寫入的個人設定（名字等）；團隊設定在 _bmad/custom/config.toml
_bmad/config.user.toml

# 依賴與建置產物
node_modules/
dist/
.venv/
__pycache__/
*.pyc

# 測試與覆蓋率
.coverage
htmlcov/
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# 期中文件排版的中間檔（node docs/midterm/_build/build.mjs 產生）
docs/midterm/_build/html/

# 由 scripts/generate-client.sh 產生的暫存檔
frontend/openapi.json

# 編輯器
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
