# 複製成 .env 後即可 `docker compose up`；.env 不進版本控制。
# 本專案只在本機 docker compose 執行（AD-17）。compose 預設 FASTAPI_ENV=development，
# 這時值為 changethis 的密鑰只會出現警告。若在 compose 之外執行 image 且沒有設
# FASTAPI_ENV=development，changethis 會被拒絕、程式無法啟動。

# 只能是 development 或留空（不設）；其他值（例如 production）會讓設定驗證失敗、程式無法啟動。
# 讓直接匯入 app 的指令（測試、產生 client）以開發模式執行
FASTAPI_ENV=development

PROJECT_NAME=FLOW

# JWT 簽章金鑰（Story 1.4 起使用）
SECRET_KEY=changethis

# 登入憑證有效時間（分鐘），預設 10080＝7 天；過期後要重新登入（不做 refresh token）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 前端網址（CORS 只允許這個來源）
FRONTEND_HOST=http://localhost:5173

# 瀏覽器呼叫後端 API 的網址（frontend 容器的 Vite 讀取）
VITE_API_URL=http://localhost:8000

# 第一個平台管理員：backend 啟動時建立，已存在則略過
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changethis

# 示範資料（Story 7.1）：backend 啟動時建立，已存在則略過、不覆寫
# 帳號為 organizer@、referee@、captain@、player@ 加上 DEMO_EMAIL_DOMAIN，密碼共用 DEMO_PASSWORD
# 不設定 DEMO_PASSWORD 就不載入示範資料
DEMO_PASSWORD=changethis
DEMO_EMAIL_DOMAIN=example.com

# worker 輪詢間隔（秒），限 15～30
WORKER_POLL_SECONDS=20

# Email（compose 內一律寄到 mailpit:1025，收件匣 http://localhost:8025）
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=FLOW
SMTP_USER=
SMTP_PASSWORD=

# PostgreSQL 18；測試使用同一個伺服器上的 <POSTGRES_DB>_test
# 密碼會原樣嵌入 DATABASE_URL，不可包含 URL 保留字元（@ : / # % ? & 等）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app

# 只給在主機上直接執行的工具使用；容器內的連線字串由 compose.yml 指向 db 服務
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
